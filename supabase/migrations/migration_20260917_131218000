-- HR Signal AI :: attendance (imports, staging rows, final attendance)

create table public.hr_attendance_imports (
  id uuid primary key default gen_random_uuid(),
  file_name text not null,
  file_path text,
  file_type text,
  file_size_bytes bigint,
  uploaded_by uuid references auth.users(id) on delete set null,
  status text not null default 'uploaded' check (status in ('uploaded','parsed','preview_ready','confirmed','failed')),
  total_rows integer not null default 0,
  valid_rows integer not null default 0,
  invalid_rows integer not null default 0,
  duplicate_rows integer not null default 0,
  confirmed_at timestamptz,
  failure_reason text,
  column_mapping jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index hr_attendance_imports_status_idx on public.hr_attendance_imports(status);
create index hr_attendance_imports_created_idx on public.hr_attendance_imports(created_at desc);

create table public.hr_attendance_import_rows (
  id uuid primary key default gen_random_uuid(),
  import_id uuid not null references public.hr_attendance_imports(id) on delete cascade,
  row_number integer not null,
  raw_values jsonb not null default '{}'::jsonb,
  employee_code text,
  employee_id uuid references public.hr_employees(id) on delete set null,
  attendance_date date,
  check_in_time text,
  check_out_time text,
  validation_status text not null default 'pending' check (validation_status in ('valid','invalid','duplicate','pending')),
  validation_errors jsonb not null default '[]'::jsonb,
  attendance_id uuid,
  created_at timestamptz not null default now()
);
create index hr_attendance_import_rows_import_idx on public.hr_attendance_import_rows(import_id);
create index hr_attendance_import_rows_status_idx on public.hr_attendance_import_rows(validation_status);
create index hr_attendance_import_rows_code_idx on public.hr_attendance_import_rows(employee_code);

create table public.hr_attendance (
  id uuid primary key default gen_random_uuid(),
  employee_id uuid not null references public.hr_employees(id) on delete cascade,
  attendance_date date not null,
  check_in timestamptz,
  check_out timestamptz,
  working_minutes integer check (working_minutes is null or working_minutes >= 0),
  overtime_minutes integer not null default 0 check (overtime_minutes >= 0),
  status text not null check (status in ('present','absent','late','half-day','leave','holiday')),
  import_source uuid references public.hr_attendance_imports(id) on delete set null,
  notes text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint hr_attendance_employee_date_unique unique (employee_id, attendance_date)
);
create index hr_attendance_date_idx on public.hr_attendance(attendance_date desc);
create index hr_attendance_employee_idx on public.hr_attendance(employee_id);
create index hr_attendance_status_idx on public.hr_attendance(status);
create index hr_attendance_import_idx on public.hr_attendance(import_source);

create trigger hr_attendance_imports_updated_at before update on public.hr_attendance_imports for each row execute function public.hr_set_updated_at();
create trigger hr_attendance_updated_at before update on public.hr_attendance for each row execute function public.hr_set_updated_at();

create index hr_attendance_import_rows_attendance_idx on public.hr_attendance_import_rows(attendance_id);

grant select, insert, update, delete on public.hr_attendance_imports to authenticated;
grant select, insert, update, delete on public.hr_attendance_import_rows to authenticated;
grant select, insert, update, delete on public.hr_attendance to authenticated;

alter table public.hr_attendance_imports enable row level security;
alter table public.hr_attendance_import_rows enable row level security;
alter table public.hr_attendance enable row level security;

create policy hr_attendance_imports_hr_all on public.hr_attendance_imports for all to authenticated using (public.hr_is_hr()) with check (public.hr_is_hr());
create policy hr_attendance_imports_founder_select on public.hr_attendance_imports for select to authenticated using (public.hr_is_founder());

create policy hr_attendance_import_rows_hr_all on public.hr_attendance_import_rows for all to authenticated using (public.hr_is_hr()) with check (public.hr_is_hr());
create policy hr_attendance_import_rows_founder_select on public.hr_attendance_import_rows for select to authenticated using (public.hr_is_founder());

create policy hr_attendance_hr_all on public.hr_attendance for all to authenticated using (public.hr_is_hr()) with check (public.hr_is_hr());
create policy hr_attendance_founder_select on public.hr_attendance for select to authenticated using (public.hr_is_founder());
