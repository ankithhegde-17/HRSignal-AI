-- HR Signal AI :: tasks + performance reviews

create table public.hr_tasks (
  id uuid primary key default gen_random_uuid(),
  employee_id uuid references public.hr_employees(id) on delete cascade,
  department_id uuid references public.hr_departments(id) on delete set null,
  title text not null,
  description text,
  assigned_by uuid references auth.users(id) on delete set null,
  due_date date,
  completed_date date,
  priority text not null default 'medium' check (priority in ('low','medium','high','critical')),
  status text not null default 'todo' check (status in ('todo','in_progress','blocked','completed','cancelled')),
  completion_percent integer not null default 0 check (completion_percent between 0 and 100),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index hr_tasks_employee_idx on public.hr_tasks(employee_id);
create index hr_tasks_department_idx on public.hr_tasks(department_id);
create index hr_tasks_status_idx on public.hr_tasks(status);
create index hr_tasks_due_idx on public.hr_tasks(due_date);

create table public.hr_performance_reviews (
  id uuid primary key default gen_random_uuid(),
  employee_id uuid not null references public.hr_employees(id) on delete cascade,
  department_id uuid references public.hr_departments(id) on delete set null,
  reviewer_id uuid references auth.users(id) on delete set null,
  period_start date not null,
  period_end date not null,
  performance_score numeric(5,2) check (performance_score is null or performance_score between 0 and 100),
  goal_score numeric(5,2) check (goal_score is null or goal_score between 0 and 100),
  task_score numeric(5,2) check (task_score is null or task_score between 0 and 100),
  manager_rating integer check (manager_rating is null or manager_rating between 1 and 5),
  comments text,
  status text not null default 'draft' check (status in ('draft','submitted','acknowledged','closed')),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  constraint hr_perf_period_valid check (period_end >= period_start)
);
create index hr_performance_employee_idx on public.hr_performance_reviews(employee_id);
create index hr_performance_department_idx on public.hr_performance_reviews(department_id);
create index hr_performance_status_idx on public.hr_performance_reviews(status);
create index hr_performance_period_idx on public.hr_performance_reviews(period_end desc);
create unique index hr_performance_employee_period_uidx on public.hr_performance_reviews(employee_id, period_start, period_end);

create trigger hr_tasks_updated_at before update on public.hr_tasks for each row execute function public.hr_set_updated_at();
create trigger hr_performance_reviews_updated_at before update on public.hr_performance_reviews for each row execute function public.hr_set_updated_at();

grant select, insert, update, delete on public.hr_tasks to authenticated;
grant select, insert, update, delete on public.hr_performance_reviews to authenticated;

alter table public.hr_tasks enable row level security;
alter table public.hr_performance_reviews enable row level security;

create policy hr_tasks_hr_all on public.hr_tasks for all to authenticated using (public.hr_is_hr()) with check (public.hr_is_hr());
create policy hr_tasks_founder_select on public.hr_tasks for select to authenticated using (public.hr_is_founder());

create policy hr_performance_hr_all on public.hr_performance_reviews for all to authenticated using (public.hr_is_hr()) with check (public.hr_is_hr());
create policy hr_performance_founder_select on public.hr_performance_reviews for select to authenticated using (public.hr_is_founder());
